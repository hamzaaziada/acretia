{
  "family": "claude",
  "match": [
    "^(anthropic[/.])?claude",
    "^(us|eu)\\.anthropic\\."
  ],
  "context_window": 200000,
  "supports_vision": true,
  "supports_json_schema": true,
  "max_output_tokens": 8192,
  "recommended": {
    "default": {
      "planner": "claude-sonnet-5-5",
      "worker": "claude-haiku-5-5",
      "verifier": "claude-sonnet-5-5",
      "critic": "claude-sonnet-5-5"
    },
    "extraction": {
      "planner": "claude-sonnet-5-5",
      "worker": "claude-haiku-5-5",
      "verifier": "claude-sonnet-5-5",
      "critic": "claude-sonnet-5-5"
    },
    "modeling": {
      "planner": "claude-sonnet-5-5",
      "worker": "claude-sonnet-5-5",
      "verifier": "claude-sonnet-5-5",
      "critic": "claude-sonnet-5-5"
    }
  },
  "prompt_quirks": {
    "caching": "explicit_breakpoints (cache_control ephemeral on the system block)",
    "tool_calling": "native, parallel, strict schemas",
    "edit_format": "exact_replace",
    "sampling": {
      "temperature": 0.0
    },
    "style": "numbered method, minimal examples"
  },
  "price_per_mtok": {
    "input": 4.0,
    "output": 20.0
  },
  "notes": "price_per_mtok is the highest-priced listed model, USD per million tokens (conservative). Haiku 5.5 lists two price rows; the higher one is used.",
  "prices_per_mtok_by_model": {
    "claude-sonnet-5-5": {
      "input": 2.0,
      "output": 10.0
    },
    "claude-haiku-5-5": {
      "input": 0.5,
      "output": 2.5
    },
    "claude-opus-5-5": {
      "input": 4.0,
      "output": 20.0
    }
  },
  "price_verified": true,
  "price_date": "2026-11-16",
  "price_source": [
    "https://platform.claude.com/docs/en/about-claude/pricing"
  ]
}
