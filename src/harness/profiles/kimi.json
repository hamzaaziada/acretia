{
  "family": "kimi",
  "match": [
    "^(moonshot(ai)?[/-])?kimi",
    "^moonshot"
  ],
  "context_window": 256000,
  "supports_vision": false,
  "supports_json_schema": false,
  "max_output_tokens": 8192,
  "recommended": {
    "default": {
      "planner": "kimi-k2",
      "worker": "kimi-k2",
      "verifier": "kimi-k2",
      "critic": "kimi-k2"
    }
  },
  "prompt_quirks": {
    "caching": "automatic_prefix",
    "sampling": "newer kimi models reject the temperature parameter (400); omit it",
    "tool_calling": "native, parallel",
    "json_mode": "json_object; validate output locally"
  },
  "price_per_mtok": {
    "input": 1.2,
    "output": 5.0
  },
  "notes": "price_per_mtok is the highest-priced listed model, USD per million tokens (conservative). Not verified this pass; conservative. Unverified: price_verified is false.",
  "prices_per_mtok_by_model": {
    "kimi-k2": {
      "input": 1.2,
      "output": 5.0
    }
  },
  "price_verified": false,
  "price_date": "2026-11-16",
  "price_source": []
}
