# SEC fair-access policy: identify yourself with a contact email
SEC_USER_AGENT="Your Name or Company your@email.com"

# ---- AI models (all optional; with none set, the Matrix uses its extractive engine)
# Pick a default for every stage, and override per stage as you tune cost/quality later.
# Spec format: provider[:model]  — providers: anthropic, deepseek, openai, openrouter, groq,
# together, fireworks, mistral, ollama, or any OpenAI-compatible server (see below).
# OM_MODEL_DEFAULT=deepseek:deepseek-chat
# OM_MODEL_MATRIX=deepseek:deepseek-chat
# OM_MODEL_SHEETS_AGENT=anthropic:claude-opus-5-5
# DEEPSEEK_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
# Self-hosted / other OpenAI-compatible endpoint, used as OM_MODEL_MATRIX=mygpu:Qwen/Qwen2.5-72B-Instruct
# OM_PROVIDER_MYGPU_BASE_URL=http://gpu-box:8000/v1
# OM_PROVIDER_MYGPU_API_KEY_ENV=MYGPU_KEY

# ---- Market data (licensed) for market cap / EV / multiples
# PRICES_CSV=/path/to/eod_prices.csv        # columns: ticker,date,close,currency[,ordinary_per_unit]
# TWELVEDATA_API_KEY=

# ---- Data-room connectors (tokens are read from here, never stored in the app)
# BOX_ACCESS_TOKEN=
# MS_GRAPH_TOKEN=
# DROPBOX_ACCESS_TOKEN=
